{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./src"
  },
  "exclude": ["__tests__", "coverage", "dist", "node_modules"],
  "include": ["src"]
}
