{
  "name": "setup-acton",
  "version": "1.0.0",
  "private": true,
  "description": "Set up your GitHub Actions workflow with a specific version of Acton",
  "keywords": [
    "actions",
    "setup",
    "ton",
    "ton-blockchain",
    "github-actions",
    "acton"
  ],
  "homepage": "https://github.com/ton-blockchain/setup-acton",
  "bugs": {
    "url": "https://github.com/ton-blockchain/setup-acton/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ton-blockchain/setup-acton.git"
  },
  "license": "MIT",
  "author": "TON Core",
  "type": "module",
  "main": "./dist/setup/index.cjs",
  "scripts": {
    "all": "bun prune --dry-run && bun run format && bun run lint && bun run test && bun run package",
    "bundle": "bun run format:write && bun run package",
    "changelog:check": "bun run scripts/check-changelog.ts",
    "checksums:update": "bun run scripts/download-current-checksums.ts",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome check --formatter-enabled=false .",
    "lint:fix": "biome check --formatter-enabled=false --write .",
    "package": "bun run typecheck && bun run scripts/build-dist.ts",
    "package:watch": "bun run package -- --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/core": "^7.0.7",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^25.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.28.1",
    "remark": "^15.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
